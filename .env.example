# ── Required ────────────────────────────────────────────────
# Your local PostgreSQL. The database is created automatically by `npm run db:setup`.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/foodsync
# Any long random string (used to sign logins and delivery QR codes)
JWT_SECRET=change-me-to-a-long-random-string

# ── Optional ────────────────────────────────────────────────
PORT=5000
LOG_LEVEL=info
JWT_EXPIRES_IN=12h
# Real weather from Open-Meteo (free, no key). Set false when offline.
WEATHER_ENABLED=true
JOBS_ENABLED=true
JOB_INTERVAL_SEC=60

# ── Demo seed (npm run db:seed) ─────────────────────────────
SEED_PASSWORD=FoodSync@123
SEED_CITY_NAME=New Delhi
SEED_CITY_LAT=28.6139
SEED_CITY_LNG=77.2090
SEED_HISTORY_DAYS=210
SEED_GO_LIVE_DAYS=60

# ── IoT simulator (npm run simulate) ────────────────────────
SIM_API_URL=http://localhost:5000
SIM_INTERVAL_SEC=30
